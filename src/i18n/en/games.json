    "list": {
      "stackTower": {
        "name": "Stack tower",
        "length": "40 sec",
        "how": "A slab slides back and forth. Tap to drop it on the tower. Whatever hangs over gets cut off."
      },
      "rocketHop": {
        "name": "Rocket hop",
        "length": "40 sec",
        "how": "The next planet swings side to side. Wait until it lines up above you. Tap to launch and land on it."
      },
      "laneDash": {
        "name": "Lane dash",
        "length": "30 sec",
        "how": "Red blocks and white gems come at you. Swipe left or right to switch lanes. It speeds up the longer you last."
      },
      "blockFit": {
        "name": "Block fit",
        "length": "45 sec",
        "how": "Pick a block from the tray. Drop it where it fits on the board. Fill a whole row or column to clear it."
      },
      "colourWord": {
        "name": "Colour word",
        "length": "40 sec",
        "how": "Look at the ink, not the word. Find that colour below. Tap it before the next word."
      },
      "middleArrow": {
        "name": "Middle arrow",
        "length": "40 sec",
        "how": "Five arrows appear in a row. Only the middle one counts. Tap its direction, ignore the crowd."
      },
      "dontTapRed": {
        "name": "Don't tap red",
        "length": "30 sec",
        "how": "Shapes pop up all over. Tap every one that isn't red. Let the red ones pass."
      },
      "echo": {
        "name": "Echo",
        "length": "45 sec",
        "how": "Shapes slide past one at a time. Press Match if it's the same as two back. Otherwise just let it pass."
      },
      "cardPairs": {
        "name": "Card pairs",
        "length": "40 sec",
        "how": "Memorise the cards. They flip face down. Find the pairs."
      },
      "breathCount": {
        "name": "Breath count",
        "length": "90 sec",
        "how": "Breathe in as the pearl grows. Breathe out as it shrinks. Tap once on each out-breath, up to nine."
      },
      "silence": {
        "name": "Silence",
        "length": "2–5 min",
        "how": "Choose how long. Let it be quiet. Nothing to do. A soft chime when time is up."
      },
      "urgeSurfing": {
        "name": "Urge surfing",
        "length": "60–90 sec",
        "how": "Notice the urge to open the app. Watch it rise and fall like a wave. Then choose what to do, on purpose."
      },
      "swapIt": {
        "name": "Swap it",
        "length": "40 sec",
        "how": "See which card hides the star. Follow it while the cards swap. Tap where it ended up."
      },
      "flashCount": {
        "name": "Flash count",
        "length": "40 sec",
        "how": "Dots flash for a moment. Count them without blinking. Tap how many you saw."
      },
      "spotTheOddOne": {
        "name": "Spot the odd one",
        "length": "30 sec",
        "how": "Sixteen tiles appear. One is a shade off or flipped. Tap the odd one out."
      },
      "trackTheStars": {
        "name": "Track the stars",
        "length": "45 sec",
        "how": "A few beads glow for a moment. Then they all look the same and drift. When they stop, tap the ones you followed."
      },
      "patternRecall": {
        "name": "Pattern recall",
        "length": "32 sec",
        "how": "Watch the pads light up. Wait for your turn. Tap them in the same order."
      },
      "numberSpan": {
        "name": "Number span",
        "length": "45 sec",
        "how": "Digits flash one at a time. Hold them in your head. Type them back in order."
      }
    },

    "list": {
      "stackTower": {
        "name": "Stack tower",
        "length": "40 sec",
        "how": "A slab slides back and forth. Tap to drop it on the tower. Whatever hangs over gets cut off."
      },
      "rocketHop": {
        "name": "Rocket hop",
        "length": "40 sec",
        "how": "The next planet swings side to side. Wait until it lines up above you. Tap to launch and land on it."
      },
      "laneDash": {
        "name": "Lane dash",
        "length": "30 sec",
        "how": "Red blocks and white gems come at you. Swipe left or right to switch lanes. It speeds up the longer you last."
      },
      "blockFit": {
        "name": "Block fit",
        "length": "45 sec",
        "how": "Pick a block from the tray. Drop it where it fits on the board. Fill a whole row or column to clear it."
      },
      "colourWord": {
        "name": "Colour word",
        "length": "40 sec",
        "how": "Look at the ink, not the word. Find that colour below. Tap it before the next word."
      },
      "middleArrow": {
        "name": "Middle arrow",
        "length": "40 sec",
        "how": "Five arrows appear in a row. Only the middle one counts. Tap its direction, ignore the crowd."
      },
      "dontTapRed": {
        "name": "Don't tap red",
        "length": "30 sec",
        "how": "Shapes pop up all over. Tap every one that isn't red. Let the red ones pass."
      },
      "echo": {
        "name": "Echo",
        "length": "45 sec",
        "how": "Shapes slide past one at a time. Press Match if it's the same as two back. Otherwise just let it pass."
      },
      "cardPairs": {
        "name": "Card pairs",
        "length": "40 sec",
        "how": "Memorise the cards. They flip face down. Find the pairs."
      },
      "breathCount": {
        "name": "Breath count",
        "length": "90 sec",
        "how": "Breathe in as the pearl grows. Breathe out as it shrinks. Tap once on each out-breath, up to nine."
      },
      "silence": {
        "name": "Silence",
        "length": "2–5 min",
        "how": "Choose how long. Let it be quiet. Nothing to do. A soft chime when time is up."
      },
      "urgeSurfing": {
        "name": "Urge surfing",
        "length": "60–90 sec",
        "how": "Notice the urge to open the app. Watch it rise and fall like a wave. Then choose what to do, on purpose."
      },
      "swapIt": {
        "name": "Swap it",
        "length": "40 sec",
        "how": "See which card hides the star. Follow it while the cards swap. Tap where it ended up."
      },
      "flashCount": {
        "name": "Flash count",
        "length": "40 sec",
        "how": "Dots flash for a moment. Count them without blinking. Tap how many you saw."
      },
      "spotTheOddOne": {
        "name": "Spot the odd one",
        "length": "30 sec",
        "how": "Sixteen tiles appear. One is a shade off or flipped. Tap the odd one out."
      },
      "trackTheStars": {
        "name": "Track the stars",
        "length": "45 sec",
        "how": "A few beads glow for a moment. Then they all look the same and drift. When they stop, tap the ones you followed."
      },
      "patternRecall": {
        "name": "Pattern recall",
        "length": "32 sec",
        "how": "Watch the pads light up. Wait for your turn. Tap them in the same order."
      },
      "numberSpan": {
        "name": "Number span",
        "length": "45 sec",
        "how": "Digits flash one at a time. Hold them in your head. Type them back in order."
      },
      "stopOnTheBeep": {
        "name": "Stop on the beep",
        "length": "40 sec",
        "how": "An arrow appears: tap that way fast. If the screen flashes red, freeze. Holding still on a flash scores too."
      },
      "oppositeDay": {
        "name": "Opposite day",
        "length": "40 sec",
        "how": "An arrow appears on the token. Think of the opposite way. Tap that arrow on the pad."
      },
      "ruleFlip": {
        "name": "Rule flip",
        "length": "40 sec",
        "how": "Read the rule at the top. Send each piece to its side. When the rule flips, follow the new one."
      },
      "sortTheStream": {
        "name": "Sort the stream",
        "length": "40 sec",
        "how": "Cards stream in one after another. Swipe left or right by the rule. When the rule switches, switch with it."
      },
      "quickMaths": {
        "name": "Quick maths",
        "length": "30 sec",
        "how": "A sum appears. Work it out before the ring closes. Tap the right answer."
      },
      "biggerTotal": {
        "name": "Bigger total",
        "length": "40 sec",
        "how": "Two stacks of number tiles. Add each stack in your head. Tap the bigger one before the bar runs out."
      },
      "timeItRight": {
        "name": "Time it right",
        "length": "5 tries",
        "how": "The hand starts sweeping. At 2 seconds it hides. Tap when you feel 5 seconds."
      },
      "orbitSwitch": {
        "name": "Orbit switch",
        "length": "30 sec",
        "how": "The marble races round its ring. Tap to hop between inner and outer ring. Dodge the red, collect the sparks."
      },
      "flowLines": {
        "name": "Flow lines",
        "length": "60 sec",
        "how": "Each colour has two jewels. Draw a tube to join each pair. No crossings, and fill every square."
      },
      "slideEscape": {
        "name": "Slide escape",
        "length": "60 sec",
        "how": "The gem has to slide out of the right side. Blocks only move along their own direction. Clear a path, then slide the gem out."
      },
      "pathPainter": {
        "name": "Path painter",
        "length": "60 sec",
        "how": "Start anywhere and draw one path. Every square has to be painted once. Plan ahead so you don't get trapped."
      },
      "oneLineArt": {
        "name": "One-line art",
        "length": "60 sec",
        "how": "Trace the whole drawing in one go. Never lift your finger, never repeat a line. Tip: start where an odd number of lines meet."
      },
      "laserLab": {
        "name": "Laser lab",
        "length": "60 sec",
        "how": "A beam fires from the emitter. Tap a mirror to turn it. Route the beam into the reactor."
      },
      "mergeGarden": {
        "name": "Merge garden",
        "length": "45 sec",
        "how": "Drag a seed onto a matching seed. Two seeds make a sprout, two sprouts a flower. Grow three flowers in as few moves as you can."
      },
      "miniNonogram": {
        "name": "Mini nonogram",
        "length": "90 sec",
        "how": "Numbers say how many squares in a row are filled. Tap squares to fill them, start with the sure ones. Solve it and the picture appears."
      },
      "bridgeBuilder": {
        "name": "Bridge builder",
        "length": "60 sec",
        "how": "Look at each gap between the posts. Drag a beam that fits it exactly. Fill every gap, then watch Pip cross."
      }
    },
